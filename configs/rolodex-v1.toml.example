# Copy to `configs/rolodex-v1.toml` to point this checkout at a corpus.
#
# The real file is gitignored: where the data sits is a property of the machine,
# not of the project. Discovery walks up from the working directory looking for
# `configs/rolodex-v1.toml`, so one file serves runs started anywhere inside the
# checkout.
#
# Precedence per location, highest first:
#   1. the command-line flag
#   2. that location's ROLODEX_V1_* environment variable
#   3. its own key below
#   4. `data` below, joined with the built-in name
#   5. `data/` in the working directory
#
# Relative paths resolve against THIS FILE's directory, not the working
# directory -- so a `data/` beside the repo root is `../data` from in here.
# `~` is expanded. Absolute paths are the unambiguous option.

[paths]

# The data root. Setting only this moves all three locations together, which is
# the usual case: an external disk, a scratch volume, a shared corpus.
data = "../data"

# Individual overrides, for when one location does not live under the root.
# Each defaults to the name shown, resolved under `data`. Name them separately
# whenever the two inputs did not arrive as one directory -- an export dropped
# beside the bundle rather than inside it is the usual case.
# source_docs = "../data/obama"
# entities_bundle = "../data/obama/resolved_entities_bundle.json"
# out_dir         = "."
#
# `source_docs` is walked RECURSIVELY for `*.txt`, so the exporter's grouping by
# origin (`email/`, `pdf/`, `plaud/`, ...) can be left exactly as it arrived.
# Where the file came from is not evidence; only its text is.

# ── fetching a corpus instead of pointing at one ────────────────────────────
# With a [fetch] table, `python -m rolodex_v1.fetch_corpus` fills the two
# locations above from the memorymachines API. Without one, fetching is refused
# rather than defaulted -- inventing an environment here would ask a production
# API for somebody's documents on the strength of nothing written down.
#
# ONE CREDENTIAL FETCHES BOTH HALVES: a Firebase refresh token
# (-> $MM_REFRESH_TOKEN), exchanged for the short-lived ID token that the bundle
# route and the files routes both take as a bearer. The bundle used to want a
# master `x-api-key` and no longer does. `--only bundle` / `--only source-docs`
# picks a half; it is no longer a way of working around a missing credential.
#
# No secret goes in this file: it names the VARIABLE, and the value is read from
# the environment or the gitignored .env.local.
#
# Both halves are incremental. Documents already on disk are skipped, so an
# interrupted fetch resumes; an existing bundle is left alone unless --force,
# because it is what every checkpointed entity id means.

# [fetch]
# environment = "prod"          # REQUIRED, prod | staging | dev. No default:
#                               # it decides whose API is asked.
# base_url = "https://..."      # override the environment's base
# sources = ["email", "pdf"]    # default: every source type the API defines
# refresh_token_env = "MM_REFRESH_TOKEN"
#
# There is deliberately no top_k, case or include_aliases. The bundle is always
# fetched whole and with aliases: a subset under the same filename is a
# different artifact that nothing downstream can tell apart.
