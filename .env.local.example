# Copy to .env.local (gitignored). The environment wins over this file, and a
# value is read only when the command that needs it runs. Keep each value on
# its own line with nothing after it: the reader takes the rest of the line.

# build_profiles, OpenAI-hosted models: read first, then OPENAI_API_KEY.
OPENAI_API_KEY_SMALL="API KEY GOES HERE"
# OPENAI_API_KEY=""

# build_profiles --model qwen*: the self-hosted deployment's serving token.
# QWEN_API_KEY=""

# fetch_corpus: one credential fetches the whole corpus (see AGENTS.md,
# "Fetching a corpus"). The bundle route and the files routes both take a
# Firebase bearer minted from this refresh token, which may also come from the
# desktop app's keychain item or its token file when this is unset.
# MM_REFRESH_TOKEN=""
